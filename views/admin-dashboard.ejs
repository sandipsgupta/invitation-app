<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Event admin</title>
  <link rel="stylesheet" href="/css/base.css">
</head>
<body style="background: #F4F2EE; display: block; padding: 32px 16px 64px;">
  <div class="admin-shell">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:18px;">
      <h1 style="margin:0; font-size:24px;">Event admin</h1>
      <a href="/admin/logout" class="btn btn-secondary" style="text-decoration:none;">Log out</a>
    </div>

    <% if (saved) { %>
      <p class="saved-banner">Saved.</p>
    <% } %>

    <div class="admin-card">
      <h2 style="margin-top:0;">Create a new event</h2>
      <div class="type-cards">
        <% eventTypeCards.forEach(function (card) { %>
          <% if (card.enabled) { %>
            <form method="POST" action="/admin/events">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="type" value="<%= card.key %>">
              <button type="submit" class="type-card">
                <span class="emoji"><%= card.emoji %></span>
                <span class="label"><%= card.label %></span>
              </button>
            </form>
          <% } else { %>
            <div class="type-card disabled">
              <span class="emoji"><%= card.emoji %></span>
              <span class="label"><%= card.label %></span>
              <span class="soon">Coming soon</span>
            </div>
          <% } %>
        <% }) %>
      </div>
    </div>

    <div class="admin-card">
      <h2 style="margin-top:0;">Your events</h2>
      <% if (events.length === 0) { %>
        <p style="color:#746E60; font-size:14px;">No events yet — create one above.</p>
      <% } else { %>
        <div class="event-list">
          <% events.forEach(function (row) { %>
            <a class="event-row" href="/admin/events/<%= row.event.id %>/edit">
              <span>
                <strong><%= row.event.personName ? row.event.personName + "'s Birthday" : (row.event.title || 'Untitled birthday') %></strong>
                <span class="badge <%= row.event.status === 'live' ? 'badge-live' : 'badge-draft' %>"><%= row.event.status %></span>
              </span>
              <span class="meta">
                <%= row.inviteCount %>/<%= row.event.maxFamilies %> families invited &middot;
                <%= row.yesCount %> yes &middot; <%= row.noCount %> no &middot; <%= row.guestTotal %> guests
              </span>
            </a>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>
</body>
</html>
