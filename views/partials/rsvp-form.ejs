<%
  const prefill = (typeof formOverride !== 'undefined' && formOverride) ? formOverride : (invite.rsvp || {});
%>
<% if (typeof error !== 'undefined' && error) { %>
  <p class="error-note"><%= error %></p>
<% } %>

<form class="rsvp-form" method="POST" action="/i/<%= invite.token %>/rsvp">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="field">
    <label for="name">Your name</label>
    <input type="text" id="name" name="name" placeholder="Full name" required maxlength="120" value="<%= prefill.name || '' %>">
  </div>

  <div class="field">
    <label>Will you be attending?</label>
    <div class="attending-choice">
      <input type="radio" id="yes" name="attending" value="yes" <%= prefill.attending !== 'no' ? 'checked' : '' %>>
      <label for="yes">🎉 Joyfully accept</label>
      <input type="radio" id="no" name="attending" value="no" <%= prefill.attending === 'no' ? 'checked' : '' %>>
      <label for="no">Can't make it</label>
    </div>
  </div>

  <div class="field">
    <label for="guests">Number of guests (including you) — <%= event.guestRange.min %>&ndash;<%= event.guestRange.max %></label>
    <input type="number" id="guests" name="guests" min="<%= event.guestRange.min %>" max="<%= event.guestRange.max %>" value="<%= prefill.guests || event.guestRange.min %>">
  </div>

  <div class="field">
    <label for="note">A note for the hosts (optional)</label>
    <textarea id="note" name="note" rows="2" maxlength="500" placeholder="Dietary notes, a message, anything else..."><%= prefill.note || '' %></textarea>
  </div>

  <button type="submit" class="submit-btn"><%= invite.rsvp ? 'Update RSVP' : 'Send RSVP' %></button>
</form>
