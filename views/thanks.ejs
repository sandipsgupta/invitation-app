<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RSVP received</title>
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/theme-<%= config.theme %>.css">
</head>
<body>
  <div class="page">
    <div class="card">
      <div class="card-body center-card">
        <div class="big-check"><%= attending ? '🎉' : '💌' %></div>
        <h1 class="title">
          <%= attending ? "You're on the list!" : "Thanks for letting us know" %>
        </h1>
        <p class="message">
          <%= attending
            ? "We've got your RSVP and can't wait to see you there."
            : "We'll miss you, but thank you for the response." %>
        </p>
        <p class="footnote"><a href="/">Back to invitation</a></p>
      </div>
    </div>
  </div>
</body>
</html>
