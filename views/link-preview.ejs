<%
  const previewTitle = event.title || (event.personName ? event.personName + "'s Birthday" : "You're Invited");
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= previewTitle %></title>
  <meta property="og:title" content="<%= previewTitle %>">
  <meta property="og:description" content="Tap to open and RSVP.">
  <meta property="og:type" content="website">
  <link rel="stylesheet" href="/css/base.css">
</head>
<body style="background:#F4F2EE;">
  <div class="page">
    <div class="card">
      <div class="card-body center-card">
        <h1 class="title"><%= previewTitle %></h1>
        <p class="message">Open this link to RSVP.</p>
      </div>
    </div>
  </div>
</body>
</html>
