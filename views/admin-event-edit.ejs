<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit event — Admin</title>
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/backgrounds.css">
</head>
<body style="background: #F4F2EE; display: block; padding: 32px 16px 64px;">
  <div class="admin-shell">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:18px;">
      <a href="/admin/dashboard" class="btn btn-secondary" style="text-decoration:none;">&larr; All events</a>
      <a href="/admin/logout" class="btn btn-secondary" style="text-decoration:none;">Log out</a>
    </div>

    <% if (saved) { %>
      <p class="saved-banner">Saved.</p>
    <% } %>
    <% if (error) { %>
      <p class="error-note"><%= error %></p>
    <% } %>

    <div class="admin-card">
      <div style="display:flex; justify-content:space-between; align-items:center;">
        <h2 style="margin-top:0;">Birthday details</h2>
        <a class="btn btn-secondary" style="text-decoration:none;" href="/admin/events/<%= event.id %>/preview" target="_blank" rel="noopener">Preview invite page &#8599;</a>
      </div>
      <form method="POST" action="/admin/events/<%= event.id %>" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="admin-grid">
          <div>
            <label for="personName">Whose birthday</label>
            <input type="text" id="personName" name="personName" value="<%= event.personName %>" placeholder="Name">
          </div>
          <div>
            <label for="personRelation">Relation</label>
            <select id="personRelation" name="personRelation">
              <% relations.forEach(function (r) { %>
                <option value="<%= r %>" <%= event.personRelation === r ? 'selected' : '' %>><%= r %></option>
              <% }) %>
            </select>
          </div>
          <div class="field-full">
            <label for="title">Custom title (optional &mdash; leave blank for "[Name]'s Birthday")</label>
            <input type="text" id="title" name="title" value="<%= event.title %>" placeholder="e.g. Aanya Turns 8!">
          </div>
        </div>

        <label for="photo">Photo (optional &mdash; JPEG, PNG, or WEBP, up to 5MB)</label>
        <% if (event.photoPath) { %>
          <div class="current-photo">
            <img src="<%= event.photoPath %>" alt="Current photo">
            <span style="font-size:12.5px; color:#746E60;">Current photo &mdash; upload a new one to replace it.</span>
          </div>
        <% } %>
        <input type="file" id="photo" name="photo" accept="image/jpeg,image/png,image/webp" style="margin-bottom:16px;">

        <label>Background design</label>
        <div class="background-picker">
          <% backgrounds.forEach(function (bg) { %>
            <div class="background-option">
              <input type="radio" id="bg-<%= bg %>" name="background" value="<%= bg %>" <%= event.background === bg ? 'checked' : '' %>>
              <label for="bg-<%= bg %>">
                <span class="swatch swatch-<%= bg %>"></span>
                <%= bg.replace(/-/g, ' ') %>
              </label>
            </div>
          <% }) %>
        </div>

        <div class="admin-grid">
          <div>
            <label for="date">Date</label>
            <input type="date" id="date" name="date" value="<%= event.date %>">
          </div>
          <div>
            <label for="time">Time</label>
            <input type="text" id="time" name="time" value="<%= event.time %>" placeholder="e.g. 4:00 PM">
          </div>
          <div class="field-full">
            <label for="location">Location</label>
            <input type="text" id="location" name="location" value="<%= event.location %>" placeholder="Address or venue name">
          </div>
          <div>
            <label for="rsvpBy">RSVP by (optional)</label>
            <input type="text" id="rsvpBy" name="rsvpBy" value="<%= event.rsvpBy %>" placeholder="e.g. Sept 5, 2026">
          </div>
          <div class="field-full">
            <p style="font-size:12px; color:#A99884; margin:-6px 0 14px;">This event (photo, invites, and RSVPs) is automatically deleted 7 days after the date above. Export a CSV before then if you want to keep the responses.</p>
          </div>
        </div>

        <label for="message">Custom message</label>
        <textarea id="message" name="message" rows="3" placeholder="A short note guests will see on the invite"><%= event.message %></textarea>

        <div class="admin-grid">
          <div>
            <label for="guestMin">Min guests per RSVP</label>
            <input type="number" id="guestMin" name="guestMin" min="1" max="50" value="<%= event.guestRange.min %>">
          </div>
          <div>
            <label for="guestMax">Max guests per RSVP</label>
            <input type="number" id="guestMax" name="guestMax" min="1" max="50" value="<%= event.guestRange.max %>">
          </div>
          <div class="field-full">
            <label for="maxFamilies">Max families invited (invite-link cap)</label>
            <input type="number" id="maxFamilies" name="maxFamilies" min="1" max="500" value="<%= event.maxFamilies %>">
          </div>
        </div>

        <label style="display:flex; align-items:center; gap:8px; font-weight:600; margin-bottom:16px;">
          <input type="checkbox" name="status" value="live" style="width:auto;" <%= event.status === 'live' ? 'checked' : '' %>>
          Page is live (guests with an invite link can see it and RSVP)
        </label>

        <button type="submit" class="btn btn-primary">Save event</button>
      </form>
    </div>

    <div class="admin-card">
      <h2 style="margin-top:0;">Invite links</h2>
      <div class="stat-row">
        <div class="stat"><div class="num"><%= invites.length %>/<%= event.maxFamilies %></div><div class="lbl">Families invited</div></div>
        <div class="stat"><div class="num"><%= yesCount %></div><div class="lbl">Attending</div></div>
        <div class="stat"><div class="num"><%= noCount %></div><div class="lbl">Not attending</div></div>
        <div class="stat"><div class="num"><%= guestTotal %></div><div class="lbl">Total guests</div></div>
      </div>

      <div style="background:#F7F5F0; border-radius:10px; padding:14px 16px; margin-bottom:18px;">
        <p style="margin:0 0 8px; font-size:13px; font-weight:600;">Public link — share with a group chat or broadcast</p>
        <p style="margin:0 0 10px; font-size:12px; color:#746E60;">Each person who opens this gets their own RSVP, tracked in their browser. Simpler to send, but less control than individual links below — revoke won't work per-person, and it still counts against your family cap.</p>
        <div style="display:flex; gap:10px;">
          <input type="text" id="public-link" readonly value="<%= baseUrl %>/e/<%= event.id %>" style="margin-bottom:0; background:#fff;">
          <button type="button" class="btn btn-secondary" data-copy-target="public-link" style="white-space:nowrap;">Copy</button>
        </div>
      </div>

      <% if (atCap) { %>
        <p class="error-note">You've reached the limit of <%= event.maxFamilies %> families for this event. Raise the cap above to invite more.</p>
      <% } else { %>
        <form method="POST" action="/admin/events/<%= event.id %>/invites" style="display:flex; gap:10px; margin-bottom:18px;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="text" name="familyLabel" placeholder="Optional label, e.g. Verma family" maxlength="120" style="margin-bottom:0; flex:1;">
          <button type="submit" class="btn btn-primary" style="white-space:nowrap;">+ Generate individual invite link</button>
        </form>
      <% } %>

      <% if (invites.length === 0) { %>
        <p style="color:#746E60; font-size:14px;">No invite links yet.</p>
      <% } else { %>
        <% invites.forEach(function (invite) { %>
          <div class="invite-row">
            <div class="invite-info">
              <span class="invite-primary"><%= invite.rsvp ? invite.rsvp.name : (invite.familyLabel || 'Unlabeled') %></span>
              <% if (invite.rsvp && invite.familyLabel) { %>
                <span class="invite-secondary"><%= invite.familyLabel %></span>
              <% } %>
              <% if (invite.rsvp && invite.rsvp.note) { %>
                <span class="invite-note" title="<%= invite.rsvp.note %>">&ldquo;<%= invite.rsvp.note %>&rdquo;</span>
              <% } %>
            </div>
            <% if (invite.source === 'public') { %>
              <span style="font-size:11.5px; color:#A99884; flex:1;">via public link</span>
            <% } else { %>
              <input type="text" id="link-<%= invite.id %>" readonly value="<%= baseUrl %>/i/<%= invite.token %>">
              <button type="button" class="btn btn-secondary" data-copy-target="link-<%= invite.id %>">Copy</button>
            <% } %>
            <% if (invite.rsvp) { %>
              <span class="invite-status <%= invite.rsvp.attending %>">
                <%= invite.rsvp.attending === 'yes' ? `Yes (${invite.rsvp.guests})` : 'No' %>
              </span>
            <% } else { %>
              <span class="invite-status pending">Pending</span>
            <% } %>
            <form method="POST" action="/admin/events/<%= event.id %>/invites/<%= invite.id %>/delete" onsubmit="return confirm('Revoke this invite link?');">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-danger">Revoke</button>
            </form>
          </div>
        <% }) %>
      <% } %>

      <div style="margin-top:18px; display:flex; gap:10px; flex-wrap:wrap;">
        <a class="btn btn-secondary" href="/admin/events/<%= event.id %>/export.csv" style="text-decoration:none;">Export CSV</a>
        <form method="POST" action="/admin/events/<%= event.id %>/delete" onsubmit="return confirm('Delete this event and all its invites/RSVPs? This cannot be undone.');">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-danger">Delete event</button>
        </form>
      </div>
    </div>
  </div>

  <script src="/js/admin-event-edit.js"></script>
</body>
</html>
