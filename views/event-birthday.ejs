<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= event.personName ? event.personName + "'s Birthday" : "You're Invited" %></title>
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/backgrounds.css">
</head>
<body class="bg-<%= event.background %>">
  <% if (typeof previewMode !== 'undefined' && previewMode) { %>
    <div style="position:sticky; top:0; z-index:10; background:#1F2937; color:#fff; text-align:center; padding:10px 16px; font-size:13px; font-weight:600;">
      Preview mode — this is what guests will see. No invite link is involved.
      <a href="/admin/events/<%= event.id %>/edit" style="color:#fff; text-decoration:underline;">Back to editor</a>
    </div>
  <% } %>
  <div class="page">
    <div class="card">
      <div class="card-body">
        <p class="eyebrow">Birthday Celebration</p>

        <% if (event.photoPath) { %>
          <div class="photo-wrap">
            <div class="photo-frame">
              <img src="<%= event.photoPath %>" alt="<%= event.personName %>">
            </div>
          </div>
        <% } %>

        <h1 class="title">
          <%= event.title || (event.personName ? event.personName + "'s Birthday" : "It's a Birthday!") %>
        </h1>

        <% if (saved) { %>
          <p class="saved-banner" style="text-align:center;">Thanks — your RSVP is saved. Revisit this link anytime to update it.</p>
        <% } else if (invite.rsvp) { %>
          <p class="saved-banner" style="text-align:center;">You already responded. Update your RSVP below anytime.</p>
        <% } %>

        <% if (event.message) { %>
          <p class="message"><%= event.message %></p>
        <% } %>

        <div class="details">
          <% if (event.date) { %>
            <div class="detail-row"><span class="label">Date</span><span class="value"><%= event.date %></span></div>
          <% } %>
          <% if (event.time) { %>
            <div class="detail-row"><span class="label">Time</span><span class="value"><%= event.time %></span></div>
          <% } %>
          <% if (event.location) { %>
            <div class="detail-row"><span class="label">Where</span><span class="value"><%= event.location %></span></div>
          <% } %>
          <% if (event.rsvpBy) { %>
            <div class="detail-row"><span class="label">RSVP by</span><span class="value"><%= event.rsvpBy %></span></div>
          <% } %>
        </div>

        <%- include('partials/rsvp-form', {
          event,
          invite,
          csrfToken,
          error: typeof error !== 'undefined' ? error : null,
          formOverride: typeof formOverride !== 'undefined' ? formOverride : null,
          previewMode: typeof previewMode !== 'undefined' ? previewMode : false
        }) %>
      </div>
    </div>
    <p class="footnote">Can't wait to celebrate with you.</p>
  </div>
</body>
</html>
