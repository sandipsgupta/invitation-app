# Copy this to .env for local development (Railway: set these as service Variables instead)

# Password to access /admin
ADMIN_PASSWORD=changeme

# Random long string used to sign the admin session cookie and CSRF tokens
SESSION_SECRET=change-this-to-something-long-and-random

# Optional: where events.json / invites.json / uploaded photos are stored.
# On Railway, point this at your mounted volume path, e.g. /data
DATA_DIR=./data

# Leave unset for local dev. On Railway, set this to "production": enables
# secure cookies, refuses to boot with default ADMIN_PASSWORD/SESSION_SECRET,
# and trusts Railway's proxy for correct client IPs (rate limiting).
NODE_ENV=
