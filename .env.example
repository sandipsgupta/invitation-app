# Copy this to .env for local development (Railway: set these as service Variables instead)

# Password to access /admin
ADMIN_PASSWORD=changeme

# Random long string used to sign the admin login session cookie
SESSION_SECRET=change-this-to-something-long-and-random

# Optional: where config.json / rsvps.json are stored.
# On Railway, point this at your mounted volume path, e.g. /data
DATA_DIR=./data
